{
  "name": "ResilienceCockpit",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.10",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.1.0",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "manager@nexus.com": {
            "password": "password"
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "application-logging": true,
      "API_INFORECORD_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_INFORECORD_PROCESS_SRV",
        "credentials":{
          "destination":"SAP_API_HUB"
        }
      }
    }
  }
}
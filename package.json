{
  "name": "ResilienceCockpit",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.10",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.1.0",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-manage-suppliers": "cds watch --open nexus.resilience.cockpit.managesuppliers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy ResilienceCockpit --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-supplier-geo": "cds watch --open nexus.resilience.cockpit.suppliergeo/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "manager@nexus.com": {
            "password": "password"
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "application-logging": true,
      "API_INFORECORD_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_INFORECORD_PROCESS_SRV",
        "credentials": {
          "destination": "SAP_API_HUB"
        }
      },
      "ShippingCostAPI": {
        "kind": "rest",
        "credentials": {
          "destination": "json-db"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/manage-suppliers"
  ]
}
